# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/feedback.db

# JWT Secret (Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session
SESSION_EXPIRE_HOURS=24
MICRODOC_COMMENT_LOGIN_REQUIRED=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI (Volcengine via backend proxy)
VOLCENGINE_API_KEY=
VOLCENGINE_ENDPOINT_ID=
VOLCENGINE_MODEL=Doubao-1.5-pro-256k

# Optional AI tuning
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.6
AI_SYSTEM_PROMPT=你是一个专门介绍临平滚灯文化的AI助手。请用简洁、生动的语言回答问题，适合小学生理解。
