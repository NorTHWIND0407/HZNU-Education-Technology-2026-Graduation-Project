# 环境变量模板（复制为 .env 并按需修改）

# 默认使用本地Mock，不依赖真实API。设置为 false 以接真 API。
VITE_ENABLE_MOCK=true

# 是否启用AR功能（可在无模型或低端设备时关闭）
VITE_USE_AR=true

# 默认语言：zh 或 en
VITE_I18N_DEFAULT=zh

# 后端API地址
VITE_API_URL=http://localhost:3001/api

# WebSocket地址
VITE_WS_URL=ws://localhost:3001/ws

# 真实 AI 的密钥配置请放在 server/.env：
# VOLCENGINE_API_KEY=
# VOLCENGINE_ENDPOINT_ID=
# VOLCENGINE_MODEL=
